# scripts/lib/common.sh - Common utility functions
#!/usr/bin/env bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Get configuration value from YAML file
get_config() {
    local key="$1"
    local config_file="${CONFIG_FILE:-${HOME}/pleasy/pl.yml}"
    
    if [[ -f "$config_file" ]]; then
        # Simple YAML parser for basic key-value pairs
        grep "^${key}:" "$config_file" 2>/dev/null | sed 's/.*: *//' | tr -d '"' || echo ""
    else
        echo ""
    fi
}

# Check if a service is running
is_service_running() {
    local service="$1"
    systemctl is-active --quiet "$service"
}

# Ensure a service is running
ensure_service_running() {
    local service="$1"
    
    if ! is_service_running "$service"; then
        log_info "Starting $service..."
        sudo systemctl start "$service"
        
        if is_service_running "$service"; then
            log_success "$service started successfully"
        else
            log_error "Failed to start $service"
            return 1
        fi
    fi
}

# Get site path
get_site_path() {
    local site_name="$1"
    local www_path=$(get_config "www_path" || echo "/var/www/html")
    echo "${www_path}/${site_name}"
}

# Check if site exists
site_exists() {
    local site_name="$1"
    local site_path=$(get_site_path "$site_name")
    [[ -d "$site_path" ]]
}

# Get database name for site
get_database_name() {
    local site_name="$1"
    local db_name=$(get_config "sites.${site_name}.database" || echo "${site_name}_db")
    echo "$db_name"
}

# Check if database exists
database_exists() {
    local db_name="$1"
    mysql -u root -e "USE \`${db_name}\`;" 2>/dev/null
}

