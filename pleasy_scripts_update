# scripts/backup.sh - Modern backup script
#!/usr/bin/env bash

set -euo pipefail

PLEASY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${PLEASY_ROOT}/pl.yml"

source "${PLEASY_ROOT}/scripts/lib/common.sh"

backup_site() {
    local site_name="$1"
    local message="${2:-Automated backup}"
    
    local www_path=$(get_config "www_path" || echo "/var/www/html")
    local backup_path=$(get_config "backup.storage_path" || echo "${HOME}/pleasy/backups")
    local site_path="${www_path}/${site_name}"
    local webroot="${site_path}/web"
    
    if [[ ! -d "$site_path" ]]; then
        log_error "Site directory not found: $site_path"
        exit 1
    fi
    
    # Create backup directory
    local backup_dir="${backup_path}/${site_name}"
    mkdir -p "$backup_dir"
    
    # Generate backup name with timestamp and git hash
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local git_hash=""
    if [[ -d "${site_path}/.git" ]]; then
        git_hash="_$(cd "$site_path" && git rev-parse --short HEAD)"
    fi
    local backup_name="${timestamp}${git_hash}_${message// /_}"
    
    log_info "Creating backup: ${backup_name}"
    
    # Backup database
    log_info "Backing up database..."
    local db_name="${site_name}_db"
    mysqldump "$db_name" > "${backup_dir}/${backup_name}.sql"
    gzip "${backup_dir}/${backup_name}.sql"
    
    # Backup files
    log_info "Backing up files..."
    tar -czf "${backup_dir}/${backup_name}.tar.gz" \
        --exclude='.git' \
        --exclude='node_modules' \
        --exclude='vendor' \
        -C "$(dirname "$site_path")" \
        "$(basename "$site_path")"
    
    # Create backup manifest
    cat > "${backup_dir}/${backup_name}.manifest" << EOF
Site: ${site_name}
Date: $(date)
Message: ${message}
Database: ${backup_name}.sql.gz
Files: ${backup_name}.tar.gz
Git Hash: ${git_hash#_}
Drupal Version: $(cd "$webroot" && vendor/bin/drush status --field=drupal-version 2>/dev/null || echo "Unknown")
EOF
    
    # Clean old backups (keep last 30 days)
    local retention_days=$(get_config "backup.retention_days" || echo "30")
    find "$backup_dir" -name "*.sql.gz" -mtime +$retention_days -delete 2>/dev/null || true
    find "$backup_dir" -name "*.tar.gz" -mtime +$retention_days -delete 2>/dev/null || true
    find "$backup_dir" -name "*.manifest" -mtime +$retention_days -delete 2>/dev/null || true
    
    log_success "Backup completed: ${backup_name}"
    log_info "Location: ${backup_dir}"
}

main() {
    if [[ $# -eq 0 ]]; then
        log_error "Usage: pl backup <site_name> [message]"
        exit 1
    fi
    
    backup_site "$1" "${2:-}"
}

main "$@"

