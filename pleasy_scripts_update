# scripts/install.sh - Modern Drupal installation script
#!/usr/bin/env bash

set -euo pipefail

# Configuration
PLEASY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${PLEASY_ROOT}/pl.yml"

# Include common functions
source "${PLEASY_ROOT}/scripts/lib/common.sh"

# Parse YAML configuration (simplified)
get_config() {
    local key="$1"
    grep "^${key}:" "$CONFIG_FILE" | sed 's/.*: *//' | tr -d '"'
}

# Install a Drupal site
install_site() {
    local site_name="$1"
    local site_config="sites.${site_name}"
    
    log_info "Installing site: ${site_name}"
    
    # Get site configuration
    local site_type=$(get_config "${site_config}.type" || echo "drupal")
    local site_version=$(get_config "${site_config}.version" || echo "11")
    local site_domain=$(get_config "${site_config}.domain" || echo "pleasy.${site_name}")
    local site_database=$(get_config "${site_config}.database" || echo "${site_name}_db")
    local composer_project=$(get_config "${site_config}.composer_project" || echo "drupal/recommended-project:^11.0")
    local php_version=$(get_config "php_version" || echo "8.3")
    local www_path=$(get_config "www_path" || echo "/var/www/html")
    
    local site_path="${www_path}/${site_name}"
    local webroot="${site_path}/web"
    
    # Create site directory
    mkdir -p "$site_path"
    cd "$site_path"
    
    # Install Drupal using Composer
    log_info "Installing ${composer_project}..."
    composer create-project "$composer_project" . --no-interaction
    
    # Set permissions
    sudo chown -R www-data:www-data "$site_path"
    sudo chmod -R 755 "$site_path"
    sudo chmod -R 775 "${webroot}/sites/default/files" 2>/dev/null || true
    
    # Create database
    create_database "$site_database"
    
    # Create Nginx virtual host
    create_nginx_vhost "$site_name" "$site_domain" "$webroot" "$php_version"
    
    # Install Drupal
    log_info "Installing Drupal..."
    cd "$site_path"
    vendor/bin/drush site:install standard \
        --db-url="mysql://root@localhost/${site_database}" \
        --site-name="$site_name" \
        --account-name=admin \
        --account-pass=admin \
        --yes
    
    # Add to hosts file
    add_to_hosts "$site_domain"
    
    # Create Drush alias
    create_drush_alias "$site_name" "$site_path"
    
    log_success "Site ${site_name} installed successfully!"
    log_info "URL: http://${site_domain}"
    log_info "Admin: admin / admin"
}

# Create MySQL database
create_database() {
    local db_name="$1"
    
    log_info "Creating database: ${db_name}"
    
    mysql -u root -e "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" || {
        log_error "Failed to create database ${db_name}"
        return 1
    }
    
    log_success "Database ${db_name} created"
}

# Create Nginx virtual host
create_nginx_vhost() {
    local site_name="$1"
    local domain="$2"
    local webroot="$3"
    local php_version="$4"
    
    local nginx_sites_path=$(get_config "nginx_sites_path" || echo "/etc/nginx/sites-available")
    local nginx_enabled_path=$(get_config "nginx_enabled_path" || echo "/etc/nginx/sites-enabled")
    local php_socket="/run/php/php${php_version}-fpm.sock"
    
    log_info "Creating Nginx virtual host for ${domain}..."
    
    # Copy template and replace placeholders
    sudo cp /etc/nginx/sites-available/pleasy-template "${nginx_sites_path}/${site_name}"
    sudo sed -i "s|DOMAIN_PLACEHOLDER|${domain}|g" "${nginx_sites_path}/${site_name}"
    sudo sed -i "s|WEBROOT_PLACEHOLDER|${webroot}|g" "${nginx_sites_path}/${site_name}"
    sudo sed -i "s|PHP_SOCKET_PLACEHOLDER|${php_socket}|g" "${nginx_sites_path}/${site_name}"
    
    # Enable site
    sudo ln -sf "${nginx_sites_path}/${site_name}" "${nginx_enabled_path}/"
    
    # Test and reload Nginx
    sudo nginx -t && sudo systemctl reload nginx
    
    log_success "Nginx virtual host created for ${domain}"
}

# Add domain to hosts file
add_to_hosts() {
    local domain="$1"
    local hosts_path=$(get_config "hosts_path" || echo "/etc/hosts")
    
    if ! grep -q "$domain" "$hosts_path"; then
        echo "127.0.0.1 $domain" | sudo tee -a "$hosts_path"
        log_info "Added $domain to hosts file"
    fi
}

# Create Drush alias
create_drush_alias() {
    local site_name="$1"
    local site_path="$2"
    
    local drush_dir="${HOME}/.drush"
    local alias_file="${drush_dir}/sites/${site_name}.site.yml"
    
    mkdir -p "${drush_dir}/sites"
    
    cat > "$alias_file" << EOF
${site_name}:
  root: ${site_path}/web
  uri: http://pleasy.${site_name}
  
stg_${site_name}:
  root: ${site_path/\/${site_name}/\/stg_${site_name}}/web
  uri: http://pleasy.stg_${site_name}
EOF
    
    log_info "Created Drush alias for ${site_name}"
}

# Main function
main() {
    if [[ $# -eq 0 ]]; then
        log_error "Usage: pl install <site_name>"
        log_info "Available site types: d11, d10, varbase"
        exit 1
    fi
    
    local site_name="$1"
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        log_info "Please run 'pl init' first"
        exit 1
    fi
    
    install_site "$site_name"
}

main "$@"

