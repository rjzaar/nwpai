#!/usr/bin/env bash
##
# Linode server setup script for Vortex Drupal deployment.
#
# This script prepares a fresh Linode server for Drupal deployment
# with all necessary dependencies and configurations.
#

set -eu

#-------------------------------------------------------------------------------
# Configuration
#-------------------------------------------------------------------------------

DOMAIN="${DOMAIN:-example.com}"
DB_ROOT_PASSWORD="${DB_ROOT_PASSWORD:-$(openssl rand -base64 32)}"
DB_USER_PASSWORD="${DB_USER_PASSWORD:-$(openssl rand -base64 32)}"
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@${DOMAIN}}"
PHP_VERSION="${PHP_VERSION:-8.1}"

#-------------------------------------------------------------------------------
# Functions
#-------------------------------------------------------------------------------

setup_system() {
  echo "==> Setting up system packages..."
  
  # Update system
  apt-get update
  apt-get upgrade -y
  
  # Install essential packages
  apt-get install -y \
    curl \
    wget \
    git \
    unzip \
    software-properties-common \
    apt-transport-https \
    ca-certificates \
    gnupg \
    lsb-release \
    ufw \
    fail2ban \
    htop \
    nano \
    tree
}

setup_php() {
  echo "==> Installing PHP ${PHP_VERSION}..."
  
  # Add PHP repository
  add-apt-repository ppa:ondrej/php -y
  apt-get update
  
  # Install PHP and extensions
  apt-get install -y \
    php${PHP_VERSION} \
    php${PHP_VERSION}-fpm \
    php${PHP_VERSION}-cli \
    php${PHP_VERSION}-common \
    php${PHP_VERSION}-mysql \
    php${PHP_VERSION}-xml \
    php${PHP_VERSION}-xmlrpc \
    php${PHP_VERSION}-curl \
    php${PHP_VERSION}-gd \
    php${PHP_VERSION}-imagick \
    php${PHP_VERSION}-dev \
    php${PHP_VERSION}-imap \
    php${PHP_VERSION}-mbstring \
    php${PHP_VERSION}-opcache \
    php${PHP_VERSION}-soap \
    php${PHP_VERSION}-zip \
    php${PHP_VERSION}-intl \
    php${PHP_VERSION}-bcmath \
    php${PHP_VERSION}-redis
  
  # Configure PHP-FPM
  sed -i 's/;cgi.fix_pathinfo=1/cgi.fix_pathinfo=0/' /etc/php/${PHP_VERSION}/fpm/php.ini
  sed -i 's/memory_limit = 128M/memory_limit = 512M/' /etc/php/${PHP_VERSION}/fpm/php.ini
  sed -i 's/max_execution_time = 30/max_execution_time = 300/' /etc/php/${PHP_VERSION}/fpm/php.ini
  sed -i 's/max_input_vars = 1000/max_input_vars = 3000/' /etc/php/${PHP_VERSION}/fpm/php.ini
  sed -i 's/post_max_size = 8M/post_max_size = 100M/' /etc/php/${PHP_VERSION}/fpm/php.ini
  sed -i 's/upload_max_filesize = 2M/upload_max_filesize = 100M/' /etc/php/${PHP_VERSION}/fpm/php.ini
  
  systemctl enable php${PHP_VERSION}-fpm
  systemctl start php${PHP_VERSION}-fpm
}

setup_nginx() {
  echo "==> Installing and configuring Nginx..."
  
  apt-get install -y nginx
  
  # Create Nginx configuration for Drupal
  cat > /etc/nginx/sites-available/drupal << EOF
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    root /var/www/html/web;
    index index.php index.html index.htm;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;

    # Deny access to sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~ /vendor/.*\.php$ {
        deny all;
        return 404;
    }

    location ~ ^/sites/.*/private/ {
        return 403;
    }

    # Allow access to well-known URIs for Let's Encrypt
    location ~* ^/.well-known/ {
        allow all;
    }

    # Handle front controller pattern
    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    # Handle PHP files
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php${PHP_VERSION}-fpm.sock;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
    }

    # Handle static files
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Deny access to configuration files
    location ~ /\.ht {
        deny all;
    }
}
EOF
  
  # Remove default site and enable Drupal site
  rm -f /etc/nginx/sites-enabled/default
  ln -sf /etc/nginx/sites-available/drupal /etc/nginx/sites-enabled/
  
  # Test and restart Nginx
  nginx -t
  systemctl enable nginx
  systemctl restart nginx
}

setup_mysql() {
  echo "==> Installing and configuring MariaDB..."
  
  apt-get install -y mariadb-server mariadb-client
  
  # Secure MySQL installation
  mysql -e "UPDATE mysql.user SET Password = PASSWORD('${DB_ROOT_PASSWORD}') WHERE User = 'root'"
  mysql -e "DELETE FROM mysql.user WHERE User=''"
  mysql -e "DELETE FROM mysql.user WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1')"
  mysql -e "DROP DATABASE IF EXISTS test"
  mysql -e "DELETE FROM mysql.db WHERE Db='test' OR Db='test_%'"
  mysql -e "FLUSH PRIVILEGES"
  
  # Create Drupal database and user
  mysql -u root -p"${DB_ROOT_PASSWORD}" -e "CREATE DATABASE drupal_prod CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
  mysql -u root -p"${DB_ROOT_PASSWORD}" -e "CREATE USER 'drupal_user'@'localhost' IDENTIFIED BY '${DB_USER_PASSWORD}'"
  mysql -u root -p"${DB_ROOT_PASSWORD}" -e "GRANT ALL PRIVILEGES ON drupal_prod.* TO 'drupal_user'@'localhost'"
  mysql -u root -p"${DB_ROOT_PASSWORD}" -e "FLUSH PRIVILEGES"
  
  systemctl enable mariadb
  systemctl restart mariadb
}

setup_composer() {
  echo "==> Installing Composer..."
  
  php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');"
  php composer-setup.php --install-dir=/usr/local/bin --filename=composer
  php -r "unlink('composer-setup.php');"
  
  # Make composer available for www-data user
  chown www-data:www-data /usr/local/bin/composer
}

setup_nodejs() {
  echo "==> Installing Node.js and npm..."
  
  curl -fsSL https://deb.nodesource.com/setup_18.x | bash -
  apt-get install -y nodejs
  
  # Install global packages
  npm install -g npm@latest
}

setup_ssl() {
  echo "==> Setting up SSL with Let's Encrypt..."
  
  # Install Certbot
  apt-get install -y certbot python3-certbot-nginx
  
  # Get SSL certificate
  certbot --nginx -d ${DOMAIN} -d www.${DOMAIN} --email ${ADMIN_EMAIL} --agree-tos --non-interactive --redirect
  
  # Setup auto-renewal
  systemctl enable certbot.timer
  systemctl start certbot.timer
}

setup_security() {
  echo "==> Configuring security settings..."
  
  # Configure UFW firewall
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow ssh
  ufw allow 'Nginx Full'
  ufw --force enable
  
  # Configure fail2ban
  cat > /etc/fail2ban/jail.local << EOF
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3

[nginx-http-auth]
enabled = true
filter = nginx-http-auth
port = http,https
logpath = /var/log/nginx/error.log

[nginx-botsearch]
enabled = true
filter = nginx-botsearch
port = http,https
logpath = /var/log/nginx/error.log
maxretry = 2
EOF
  
  systemctl enable fail2ban
  systemctl restart fail2ban
}

setup_directories() {
  echo "==> Setting up directory structure..."
  
  # Create web directory structure
  mkdir -p /var/www/html/{releases,shared,shared/web/sites/default/files}
  
  # Set ownership and permissions
  chown -R www-data:www-data /var/www/html
  chmod -R 755 /var/www/html
  chmod 775 /var/www/html/shared/web/sites/default/files
}

setup_cron() {
  echo "==> Setting up Drupal cron..."
  
  # Add Drupal cron job for www-data user
  crontab -u www-data << EOF
# Run Drupal cron every hour
0 * * * * cd /var/www/html/current && /usr/local/bin/composer exec drush cron
EOF
}

print_summary() {
  echo "============================================================"
  echo "Linode server setup completed successfully!"
  echo "============================================================"
  echo "Domain: ${DOMAIN}"
  echo "Web root: /var/www/html"
  echo "PHP version: ${PHP_VERSION}"
  echo "Database root password: ${DB_ROOT_PASSWORD}"
  echo "Database user password: ${DB_USER_PASSWORD}"
  echo "============================================================"
  echo "Next steps:"
  echo "1. Update your DNS to point ${DOMAIN} to this server"
  echo "2. Deploy your Vortex application using the deployment script"
  echo "3. Update your environment variables with the database credentials"
  echo "============================================================"
  
  # Save credentials to a secure file
  cat > /root/server_credentials.txt << EOF
Server Setup Completed: $(date)
Domain: ${DOMAIN}
Database Root Password: ${DB_ROOT_PASSWORD}
Database User: drupal_user
Database User Password: ${DB_USER_PASSWORD}
Database Name: drupal_prod
Admin Email: ${ADMIN_EMAIL}
EOF
  
  chmod 600 /root/server_credentials.txt
  echo "Credentials saved to /root/server_credentials.txt"
}

#-------------------------------------------------------------------------------
# Main execution
#-------------------------------------------------------------------------------

main() {
  echo "==> Starting Linode server setup for Vortex Drupal deployment..."
  
  if [[ $EUID -ne 0 ]]; then
    echo "This script must be run as root"
    exit 1
  fi
  
  setup_system
  setup_php
  setup_nginx
  setup_mysql
  setup_composer
  setup_nodejs
  setup_directories
  setup_cron
  setup_security
  
  # Only setup SSL if domain is not example.com
  if [[ "${DOMAIN}" != "example.com" ]]; then
    setup_ssl
  else
    echo "Skipping SSL setup for example domain. Update DOMAIN variable and run setup_ssl function manually."
